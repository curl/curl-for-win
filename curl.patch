+          "EM DV TLS CA - G3B",
+          "EM OV TLS CA - G3B",
+          "EM EV TLS CA - G3B",
+          "EM DV TLS CA - G3C",
+          "EM OV TLS CA - G3C",
+          "EM EV TLS CA - G3C",
+          "EM OV CS CA - G3B",
+          "EM OV CS CA - G3C",
+          NULL
+        };
+        char cert_name[256];
+        if(CertGetNameStringA(pContext, CERT_NAME_ATTR_TYPE, 0,
+                              CURL_UNCONST(szOID_COMMON_NAME),
+                              cert_name, sizeof(cert_name)) > 1) {
+          const char * const *b;
+          for(b = blacklist; *b && strcmp(cert_name, *b); ++b)
+            ;
+          if(*b)
+            continue;
+        }
+      }
